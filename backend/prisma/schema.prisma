// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// таблиця картинок користувача
model GalleryItem {
  id       Int    @id @default(autoincrement())
  userId   Int
  url      String
  category String
  user     User   @relation(fields: [userId], references: [id])
}

// таблиця для пройдених уроків
model PassedLesson {
  id        Int      @id @default(autoincrement())
  userId    Int
  lessonId  String
  title     String
  passedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id]) // <--- ДОДАНО ЦЕЙ РЯДОК
}

// таблиця користувачів
model User {
  id            Int            @id @default(autoincrement())
  name          String?
  email         String         @unique
  password      String
  passedLessons PassedLesson[]
  galleryItems  GalleryItem[]
}